<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The backend HTTP service, for M4's /skips route.

     Without this the board fetches its skip set from a port nobody is listening
     on and degrades to an empty one -- which is the designed failure, so it fails
     quietly and looks exactly like a day with no skipped trains.

     Bound to 127.0.0.1 by server.py. `tailscale serve` is what makes it reachable
     from the rider's phone, terminating TLS on the tailnet and proxying here.

     It runs through src/serve.sh rather than uv directly, because a plist cannot
     carry MBTA_API_KEY without committing it. Everything this SERVES is public
     transit data; the key is only for what it fetches. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.magoun.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jsundram/Dropbox/Code/mbta-glx/src/serve.sh</string>
    <string>8723</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/jsundram/Dropbox/Code/mbta-glx</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/jsundram/Dropbox/Code/mbta-glx/data/live/server.out</string>
  <key>StandardErrorPath</key><string>/Users/jsundram/Dropbox/Code/mbta-glx/data/live/server.err</string>
</dict>
</plist>
