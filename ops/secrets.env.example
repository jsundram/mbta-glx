# Copy to ops/secrets.env (gitignored) and fill in. Every runtime secret lives
# here; src/watch.sh, src/serve.sh and src/daily.sh source it.
#
# ops/ntfy.env is the older name for the same file and is still read, so an
# existing install needs no migration.

# service -> phone. SUBSCRIBE to this one in the ntfy app.
MAGOUN_NTFY_TOPIC=magoun-<random>
# phone -> service: button taps and the board's `arm` handoff. Do NOT subscribe;
# subscribing echoes your own commands back as notifications.
MAGOUN_NTFY_CMD=magoun-cmd-<random>

# Free from https://api-v3.mbta.com. Without it every process here shares the
# anonymous 20 requests/minute, which is counted PER CLIENT IP -- and a single
# open board is about 12 of them. Optional, but one board plus one phone on the
# same wifi already exceeds it.
#
# The BOARD cannot read this file. Set its key per device in the browser:
#   localStorage.setItem("magoun.mbtakey", "<key>")
# and never publish it into model.json -- that file is served from a public
# origin, so a key in it is a key given away.
MBTA_API_KEY=
